function mostrarMensagem() {
    alert(
        "O Agro Forte e Sustentável busca produzir alimentos preservando a natureza!"
    );
}

const mensagens = [
    "🌱 Plantar com responsabilidade protege o futuro.",
    "💧 Economizar água é essencial para a agricultura.",
    "🌳 Preservar florestas ajuda no equilíbrio ambiental.",
    "🚜 Tecnologia e sustentabilidade podem caminhar juntas."
];

let indice = 0;

setInterval(() => {
    document.getElementById("mensagem").innerHTML =
        mensagens[indice];

    indice++;

    if(indice >= mensagens.length){
        indice = 0;
    }
}, 3000);
